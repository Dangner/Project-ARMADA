# Large data artifacts (EMBER corpus, caches, checkpoints) stay out of git.
# NOTE: patterns are ROOT-ANCHORED — `data/` (unanchored) would also match
# `armada/data/` and silently exclude the data layer from version control.
/data/
/cache/
/checkpoints/
*.dat
*.memmap

# Runtime logs (per-run logs are noisy; curated logs under logs/summary stay)
/logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Prediction dumps (large .npy); metrics CSVs in results/ are kept.
results/predictions/

# Generated paper artifacts (rebuildable via --stage figures)
/figures/
/tables/

# OS noise
.DS_Store
Zone.Identifier
